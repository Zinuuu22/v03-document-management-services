setup_logging()
logger = structlog.get_logger()

if __name__ == "__main__":
    _, core_db = connect_to_databases()
    
    count = core_db[MongoDBCollectionConfig.LAW_DOCUMENT_COLLECTION_NAME].count_documents({})
    logger.info(action="migrate_data", event="total_documents_count", count=count)
    
    # Check if data already exists in core collection
    if count > 0:
        logger.info(action="migrate_data", event="migration_skipped", detail="Data already exists in law_documents collection")
        sys.exit(0)

    # 1. Migrate documents 
    logger.info(action="migrate_data", event="migration_started")
    
    documents = list(core_db.law_documents.find({}))
    
    operations = []  # List to store bulk update operations
    for doc in documents:
        doc_id = doc.get('doc_id', None)
        try:
            content = search_document_content(doc_id=doc_id)
            operations.append(
                UpdateOne(
                    {'doc_id': doc['doc_id']},
                    {'$set': {'doc_content': content}}
                )
            )
            # Process updates in batches of 1000 to balance memory and performance
            if len(operations) >= 500:
                core_db.law_documents.bulk_write(operations, ordered=False)
                operations = []  # Clear the list after writing
        except Exception as e:
            logger.error(action="main", event="document_processing_failed", doc_id=doc_id, **{"error.message": str(e)})

    # Write any remaining operations
    if operations:
        core_db.law_documents.bulk_write(operations, ordered=False)

