   "source": [
    "# Lên lịch chạy job lúc 00:30 mỗi ngày\n",
    "scheduler = BlockingScheduler()\n",
    "scheduler.add_job(update_effective_status, 'cron', hour=0, minute=30)\n",
    "\n",
    "logger.info(\"Job đã được lên lịch. Chạy scheduler...\")\n",
    "scheduler.start()"
   ]
  }
