    "def update_effective_status(status=\"Hết hiệu lực\"):        \n",
    "    results = []    \n",
    "    try:\n",
    "        today = datetime.now().strftime("%Y-%m-%d %H:%M:%S").replace(hour=0, minute=0, second=0, microsecond=0)\n",
    "        logger.info(f\"--- Bắt đầu cập nhật trạng thái hiệu lực cho ngày {today.date()} ---\")\n",
    "\n",
    "        # Step 1: Tìm các document cần cập nhật\n",
    "        logger.info(\"Step 1: Tìm các document cần cập nhật\")\n",
    "        start_time = time.time()    \n",
    "        docs = law_documents_collection.find({\n",
    "            \"doc_effective_status\": {\"$ne\": status},\n",
    "            \"doc_effective_date\": {\"$ne\": \"\"}\n",
    "        })\n",
    "        end_time = time.time()\n",
    "        logger.info(f\"Step Process Time: {end_time - start_time}\")\n",
    "\n",
    "\n",
    "        # Step 2: Cập nhật hiệu lực của văn bản\n",
    "        logger.info(\"Step 2: Cập nhật hiệu lực của văn bản\")\n",
    "        start_time = time.time()        \n",
    "        count = 0\n",
    "        for doc in list(docs):            \n",
    "            effective_date_str = doc.get(\"doc_effective_date\")\n",
    "            logger.info(f\"doc_id: {doc['doc_id']}\")                        \n",
    "            logger.info(f\"effective_date: {doc['doc_effective_date']}\")                        \n",
    "            \n",
    "            result = {\n",
    "                \"doc_id\": doc['doc_id'],\n",
    "                \"effective_date\": doc['doc_effective_date'],\n",
    "                \"status\": \"No Update\",\n",
    "            }\n",
    "\n",
    "            if effective_date_str:\n",
    "                try:\n",
    "                    effective_date = datetime.strptime(effective_date_str, \"%Y-%m-%d %H:%M:%S\")                    \n",
    "                    if effective_date.date() < today.date():\n",
    "                        logger.info(\"Update status\")\n",
    "                        result[\"status\"] = \"Update\"\n",
    "                        # law_documents_collection.update_one(\n",
    "                        #     {\"_id\": doc[\"_id\"]},\n",
    "                        #     {\"$set\": {\"doc_effective_status\": status}}\n",
    "                        # )\n",
    "                        count += 1\n",
    "                except Exception as e:\n",
    "                    result[\"status\"] = f\"Error: {e}\"\n",
    "                    logger.warning(f\"Document {doc[\"doc_id\"]} có doc_effective_date không hợp lệ: {effective_date_str}\")        \n",
    "            results.append(result)\n",
    "\n",
    "        end_time = time.time()    \n",
    "        logger.info(f\"✅ Cập nhật xong {count} văn bản thành 'hết hiệu lực'.\")\n",
    "        logger.info(f\"Step Process Time: {end_time - start_time}\")    \n",
    "    except Exception as e:\n",
    "        logger.error(f\"❌ Lỗi khi cập nhật trạng thái hiệu lực: {e}\")\n",
    "    return results\n",
    "\n",
    "results = update_effective_status()"
   ]
  },
